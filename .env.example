# Copy to .env and fill in what you need. Everything is optional.

PORT=3000
# Set to 1 only when running behind a reverse proxy (Caddy, nginx, Cloudflare Tunnel)
TRUST_PROXY=0
# Optional: require this code to create the first (owner) account
SETUP_CODE=
# --- Email notifications — option 1: Resend (also works on Cloudflare)
RESEND_API_KEY=
EMAIL_FROM="My Repair Shop <repairs@example.com>"

# --- Email notifications — option 2: any SMTP provider (Node.js/Docker only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="My Repair Shop <repairs@example.com>"

# --- SMS notifications via Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+15555550100

# --- Or send every notification to a webhook (Zapier, Make, n8n, your SMS provider…)
NOTIFY_WEBHOOK_URL=

# --- Webhooks (Settings → Webhooks): optional secret used to sign each request (X-OpenRepairPOS-Signature)
WEBHOOK_SECRET=
