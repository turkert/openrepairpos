{
  "name": "openrepairpos",
  "version": "0.5.0",
  "description": "Free, open-source POS and repair shop management: tickets, inventory, invoices, and an MCP server for Claude & ChatGPT. One-click deploy to Cloudflare.",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "seed": "node --no-warnings scripts/seed.js",
    "test": "node --no-warnings --test test/*.test.js",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "author": "OpenRepairPOS",
  "license": "MIT",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "repair shop software",
    "repair pos",
    "cell phone repair",
    "open source pos",
    "ticketing",
    "inventory",
    "cloudflare",
    "mcp"
  ],
  "devDependencies": {
    "wrangler": "^4.156.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/turkert/openrepairpos.git"
  },
  "homepage": "https://openrepairpos.com"
}
